<%- layout("./layouts/boilerplate") %>

<style>
    #filters {
    margin-top: 1.9rem;
    display: flex;
    gap: 1.5rem;
}

.filter {
    display: flex;
    flex-direction: column;
    align-items: center;
    opacity: 0.8;
}

.filter p {
    font-size: 0.8rem;
}

.filter:hover {
    opacity: 1;
    cursor: pointer;
}
</style>

    <div id="filters">
        <div class="filter">
            <i class="fa-solid fa-fire"></i>
            <p>Trending</p>
        </div>
        <div class="filter">
            <i class="fa-solid fa-bed"></i>
            <p>Rooms</p>
        </div>
        
        <div class="filter">
            <i class="fa-solid fa-mountain-city"></i>
            <p>Iconic Cities</p>
        </div>
        <div class="filter">
            <i class="fa-solid fa-mountain"></i>
            <p>Mountains</p>
        </div>
        <div class="filter">
            <i class="fa-brands fa-fort-awesome"></i>
            <p>Castles</p>
        </div>
        <div class="filter">
            <i class="fa-solid fa-person-swimming"></i>
            <p>Amazing Pools</p>
        </div>
        <div class="filter">
            <i class="fa-solid fa-tents"></i>
            <p>Camping</p>
        </div>
        <div class="filter">
            <i class="fa-solid fa-cow"></i>
            <p>Farms</p>
        </div>
        <div class="filter">
            <i class="fa-solid fa-snowflake"></i>
            <p>Arctic</p>
        </div>
        <div class="filter">
            <i class="fa-solid fa-landmark-dome"></i>
            <p>Domes</p>
        </div>
        <div class="filter">
            <i class="fa-solid fa-ship"></i>
            <p>Boats</p>
        </div>
    </div>
    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-2">
        <%for(listing of allListings){%>
            <a href="/listings/<%=listing.id%>" class="listing-link">
                <div class="card col listing-card">
                    <img src="<%=listing.image.url%>" class="card-img-top" alt="listing_image" style="height: 20rem;">
                    <div class="card-img-overlay"></div>

                    <div class="card-body">
                        <p class="card-text">
                            <b>
                                <%=listing.title%>
                            </b> <br>
                            &#x20A8; <%=listing.price.toLocaleString("en-IN")%> / night
                        </p>
                    </div>
                </div>
            </a>
            <%}%>   
    </div>

   
